# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub (for local API usage only; GitHub Actions provides its own token)
GITHUB_TOKEN=ghp_your-github-token-here

# Webhook (only if using POST /webhook/github)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Review limits
REVIEW_MAX_FILES=20
REVIEW_MAX_DIFF_CHARS=50000
REVIEW_MAX_COMMENTS=25

# Logging
LOG_LEVEL=INFO
